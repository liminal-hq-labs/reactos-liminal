[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Nls\Language]
"Default"="1009"

[HKEY_CURRENT_USER\Control Panel\International]
"Locale"="00001009"
"LocaleName"="en-CA"
"sLanguage"="ENC"
"sCountry"="Canada"
"iCountry"="1"
"iMeasure"="0"
"iPaperSize"="1"
"sCurrency"="$"
"iCurrency"="0"
"iNegCurr"="1"
"iCurrDigits"="2"
"sDecimal"="."
"sThousand"=","
"sList"=","
"iDigits"="2"
"iLZero"="1"
"iNegNumber"="1"
"sShortDate"="yyyy-MM-dd"
"sLongDate"="MMMM d, yyyy"
"sYearMonth"="MMMM, yyyy"
"sDate"="-"
"iDate"="2"
"iFirstDayOfWeek"="6"
"iFirstWeekOfYear"="0"
"iCalendarType"="1"
"iTime"="1"
"iTLZero"="1"
"iTimePrefix"="0"
"sTime"=":"
"sTimeFormat"="HH:mm:ss"
"s1159"="a.m."
"s2359"="p.m."

[HKEY_CURRENT_USER\Control Panel\International\Geo]
"Nation"="39"
"Name"="CA"

[HKEY_USERS\.DEFAULT\Control Panel\International]
"Locale"="00001009"
"LocaleName"="en-CA"
"sLanguage"="ENC"
"sCountry"="Canada"
"iCountry"="1"
"iMeasure"="0"
"iPaperSize"="1"
"sCurrency"="$"
"iCurrency"="0"
"iNegCurr"="1"
"iCurrDigits"="2"
"sDecimal"="."
"sThousand"=","
"sList"=","
"iDigits"="2"
"iLZero"="1"
"iNegNumber"="1"
"sShortDate"="yyyy-MM-dd"
"sLongDate"="MMMM d, yyyy"
"sYearMonth"="MMMM, yyyy"
"sDate"="-"
"iDate"="2"
"iFirstDayOfWeek"="6"
"iFirstWeekOfYear"="0"
"iCalendarType"="1"
"iTime"="1"
"iTLZero"="1"
"iTimePrefix"="0"
"sTime"=":"
"sTimeFormat"="HH:mm:ss"
"s1159"="a.m."
"s2359"="p.m."

[HKEY_USERS\.DEFAULT\Control Panel\International\Geo]
"Nation"="39"
"Name"="CA"
