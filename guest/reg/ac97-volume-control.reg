[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Applets\Volume Control\AC'97 Sound Card\Volume Control]
"LineStates"=hex:00,00,00,00,56,00,6f,00,6c,00,75,00,6d,00,65,00,20,00,43,00,\
  6f,00,6e,00,74,00,72,00,6f,00,6c,00,00,00,00,00,00,00,00,00,00,00,00,00,00,\
  00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,\
  00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,\
  00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,\
  00,00,00,00,00,00,00,00,00,00,00,00

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Applets\Volume Control\AC'97 Sound Card\Recording Control]
"LineStates"=hex:00,00,00,00,4d,00,69,00,63,00,72,00,6f,00,70,00,68,00,6f,00,\
  6e,00,65,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,\
